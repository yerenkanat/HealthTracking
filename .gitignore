# Node
node_modules/
dist/
*.log

# Dart / Flutter
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/pubspec.lock
.dart_tool/

# Env / secrets (never commit health or location keys)
.env
*.pem
service-account*.json
google-services.json
GoogleService-Info.plist

# Vendored Claude Code skills (dev tooling, not product code)
# Local Claude state stays out — settings, session data, scratch.
# The agent definitions do NOT: they are how this project is built, the same
# way a CI config is, and losing them to a clean checkout would lose the
# clinical, Kazakh and privacy gates with them.
.claude/*
!.claude/agents/
!.claude/workflows/

# OS
.DS_Store
Thumbs.db

# Flutter Android build artifacts
app/android/.gradle/
app/android/local.properties
app/android/**/build/
app/.gradle/

# Flutter iOS build artifacts
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/ephemeral/
app/ios/build/
