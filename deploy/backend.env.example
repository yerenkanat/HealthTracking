# Umay backend — production env. Copy to /etc/umay/backend.env, fill the secrets,
# then `chmod 600` and `chown umay`. Never commit the filled-in version.
# Every var below is read by packages/backend/src (index.ts / server.ts).

# --- Core (required) ---
NODE_ENV=production
DATABASE_URL=postgres://umay:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/umay
HOST=127.0.0.1          # bind to localhost; Caddy faces the internet
PORT=8080

# --- Auth (required for a real launch) ---
# 1 turns on real Firebase ID-token verification for the USER path. Needs a
# Firebase service account on the box (see docs/DEPLOY.md §5). Without it the
# server accepts a dev stub token — do NOT ship that to real users.
REAL_AUTH=1

# --- Feature keys (optional; can also be entered in the admin panel) ---
# The AI advisor. If unset here, set it in the admin: Магазин → Настройки и ключи
# (it is bridged into the process env at boot).
ANTHROPIC_API_KEY=
# Google Maps (child tracking). Also settable in the admin panel.
GOOGLE_MAPS_API_KEY=
# Baby-cry classifier service (packages/cry-classifier). Unset ⇒ /cry/analyze
# returns 502 and the app shows its error state (cry HISTORY still syncs).
CRY_API_URL=

# --- Optional ---
# Locks the content-authoring API if set.
CONTENT_API_KEY=
# App force-update gate (raise APP_MIN_BUILD to block old app builds).
APP_MIN_BUILD=0
APP_LATEST_BUILD=0
# Redis-backed features; omit to run without.
# REDIS_URL=redis://127.0.0.1:6379
