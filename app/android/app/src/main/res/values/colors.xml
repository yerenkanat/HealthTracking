<resources>
    <!-- The design system's canvas (Ds.cream, #FBF6F3). This was #FBF5EF, the
         previous palette's cream, so the very first frame of the app — the
         window behind the splash — was a different colour from every screen
         that followed it. -->
    <color name="brand_bg">#FFFBF6F3</color>

    <!-- Ds.coralCta (#D6004A). Android tints the notification's small icon and the app
         name in the shade with this. -->
    <color name="brand_accent">#FFD6004A</color>
</resources>
